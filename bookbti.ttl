          <path d="M 44 22 L 40 10 L 48 16 L 50 10" fill="none" stroke="#8C5E3C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M 76 22 L 80 10 L 72 16 L 70 10" fill="none" stroke="#8C5E3C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <ellipse cx="60" cy="23" rx="18" ry="6" fill="#588157" stroke="#1B263B" stroke-width="2.5"/>
        `,
        outfitSVG: `
          <path d="M 36 74 L 84 74 L 87 94 L 33 94 Z" fill="#588157" stroke="#1B263B" stroke-width="3"/>
          <circle cx="60" cy="82" r="4" fill="#FFD166"/>
        `,
        propSVG: `
          <g class="svg-char-prop">
            <ellipse cx="96" cy="60" rx="7" ry="10" fill="#BC6C25" stroke="#1B263B" stroke-width="2.5"/>
            <line x1="86" y1="54" x2="106" y2="64" stroke="#1B263B" stroke-width="2.5" stroke-linecap="round"/>
          </g>
        `,
        fxSVG: `<text x="18" y="30" font-size="14" class="svg-char-sparkle">🎻</text><text x="96" y="28" font-size="13" class="svg-char-sparkle">🎵</text>`
      },
      'IWMK': {
        // 침묵의 불꽃 러너 (불꽃 러너 토끼/치타 + 열정 헤어밴드 + 성화 토치)
        bg: '#FFF1F0', stroke: '#1B263B', bodyColor: '#E63946', bellyColor: '#FAF8F5',
        earType: 'bunny', earColor: '#FAF8F5', innerEar: '#FF8FA3',
        faceColor: '#FFFFFF', cheekColor: '#E63946',
        eyeStyle: 'confident', mouthStyle: 'openHappy',
        hatSVG: `
          <rect x="28" y="26" width="64" height="7" rx="3.5" fill="#E63946" stroke="#1B263B" stroke-width="2.5"/>
          <polygon points="60,18 55,28 65,28" fill="#FFD166" stroke="#1B263B" stroke-width="2"/>
        `,
        outfitSVG: `
          <path d="M 36 74 L 84 74 L 87 94 L 33 94 Z" fill="#E63946" stroke="#1B263B" stroke-width="3"/>
          <rect x="48" y="78" width="24" height="12" rx="3" fill="#FAF8F5" stroke="#1B263B" stroke-width="2"/>
          <text x="60" y="87" text-anchor="middle" font-size="9" font-weight="bold" fill="#1B263B">NO.1</text>
        `,
        propSVG: `
          <g class="svg-char-prop">
            <line x1="92" y1="74" x2="100" y2="58" stroke="#1B263B" stroke-width="4" stroke-linecap="round"/>
            <path d="M 100 58 C 90 50 96 38 102 36 C 108 42 110 52 100 58 Z" fill="#FF6B35" stroke="#1B263B" stroke-width="2.5"/>
            <circle cx="101" cy="51" r="3" fill="#FFD166"/>
          </g>
        `,
        fxSVG: `<text x="18" y="30" font-size="14" class="svg-char-sparkle">🔥</text><text x="96" y="28" font-size="13" class="svg-char-sparkle">👟</text>`
      }
    };

    function createCuteCharacterSVG(code, isStaticForCursor = false) {
      const spec = characterSpecs[code] || characterSpecs['PLSN'];

      // 귀 모양 렌더링
      let earsMarkup = '';
      if (spec.earType === 'floppy') {
        earsMarkup = `
          <ellipse cx="24" cy="48" rx="9" ry="18" transform="rotate(18 24 48)" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3.2"/>
          <ellipse cx="96" cy="48" rx="9" ry="18" transform="rotate(-18 96 48)" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3.2"/>
        `;
      } else if (spec.earType === 'pointy') {
        earsMarkup = `
          <polygon points="26,38 30,14 48,28" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3.2" stroke-linejoin="round"/>
          <polygon points="30,34 32,20 43,28" fill="${spec.innerEar}"/>
          <polygon points="94,38 90,14 72,28" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3.2" stroke-linejoin="round"/>
          <polygon points="90,34 88,20 77,28" fill="${spec.innerEar}"/>
        `;
      } else if (spec.earType === 'bunny') {
        earsMarkup = `
          <ellipse cx="42" cy="18" rx="8" ry="17" transform="rotate(-10 42 18)" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3.2"/>
          <ellipse cx="42" cy="18" rx="4" ry="11" transform="rotate(-10 42 18)" fill="${spec.innerEar}"/>
          <ellipse cx="78" cy="18" rx="8" ry="17" transform="rotate(10 78 18)" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3.2"/>
          <ellipse cx="78" cy="18" rx="4" ry="11" transform="rotate(10 78 18)" fill="${spec.innerEar}"/>
        `;
      } else if (spec.earType === 'tuft') {
        earsMarkup = `
          <polygon points="24,32 32,16 42,28" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3" stroke-linejoin="round"/>
          <polygon points="96,32 88,16 78,28" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3" stroke-linejoin="round"/>
        `;
      } else {
        earsMarkup = `
          <circle cx="32" cy="28" r="12" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3.2"/>
          <circle cx="32" cy="28" r="6" fill="${spec.innerEar}"/>
          <circle cx="88" cy="28" r="12" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="3.2"/>
          <circle cx="88" cy="28" r="6" fill="${spec.innerEar}"/>
        `;
      }

      // 눈 모양 렌더링
      let eyesMarkup = '';
      if (spec.eyeStyle === 'wink') {
        eyesMarkup = `
          <circle cx="45" cy="52" r="5" fill="#1B263B"/>
          <circle cx="43.5" cy="50.5" r="2" fill="#FFFFFF"/>
          <path d="M 70 52 Q 75 46 80 52" fill="none" stroke="#1B263B" stroke-width="3.2" stroke-linecap="round"/>
        `;
      } else if (spec.eyeStyle === 'glasses') {
        eyesMarkup = `
          <circle cx="45" cy="52" r="4.8" fill="#1B263B"/>
          <circle cx="43.5" cy="50.5" r="1.8" fill="#FFFFFF"/>
          <circle cx="75" cy="52" r="4.8" fill="#1B263B"/>
          <circle cx="73.5" cy="50.5" r="1.8" fill="#FFFFFF"/>
          <circle cx="45" cy="52" r="9.5" fill="none" stroke="#C89B6E" stroke-width="2.5"/>
          <circle cx="75" cy="52" r="9.5" fill="none" stroke="#C89B6E" stroke-width="2.5"/>
          <line x1="54.5" y1="52" x2="65.5" y2="52" stroke="#C89B6E" stroke-width="2.5"/>
        `;
      } else if (spec.eyeStyle === 'confident') {
        eyesMarkup = `
          <circle cx="45" cy="53" r="5" fill="#1B263B"/>
          <circle cx="43.5" cy="51.5" r="2" fill="#FFFFFF"/>
          <circle cx="75" cy="53" r="5" fill="#1B263B"/>
          <circle cx="73.5" cy="51.5" r="2" fill="#FFFFFF"/>
          <line x1="39" y1="44" x2="50" y2="46" stroke="#1B263B" stroke-width="2.8" stroke-linecap="round"/>
          <line x1="81" y1="44" x2="70" y2="46" stroke="#1B263B" stroke-width="2.8" stroke-linecap="round"/>
        `;
      } else {
        eyesMarkup = `
          <circle cx="45" cy="52" r="5.3" fill="#1B263B"/>
          <circle cx="43.2" cy="50" r="2.2" fill="#FFFFFF"/>
          <circle cx="47" cy="54" r="1.1" fill="#FFFFFF"/>
          <circle cx="75" cy="52" r="5.3" fill="#1B263B"/>
          <circle cx="73.2" cy="50" r="2.2" fill="#FFFFFF"/>
          <circle cx="77" cy="54" r="1.1" fill="#FFFFFF"/>
        `;
      }

      // 입 모양 렌더링
      let mouthMarkup = '';
      if (spec.mouthStyle === 'openHappy') {
        mouthMarkup = `
          <path d="M 53 59 Q 60 69 67 59 Z" fill="#E63946" stroke="#1B263B" stroke-width="2.5" stroke-linejoin="round"/>
        `;
      } else if (spec.mouthStyle === 'catSmile') {
        mouthMarkup = `
          <ellipse cx="60" cy="56" rx="3" ry="2.2" fill="#1B263B"/>
          <path d="M 53 60 Q 56.5 64 60 60 Q 63.5 64 67 60" fill="none" stroke="#1B263B" stroke-width="2.6" stroke-linecap="round"/>
        `;
      } else {
        mouthMarkup = `
          <path d="M 53 59 Q 60 66 67 59" fill="none" stroke="#1B263B" stroke-width="2.8" stroke-linecap="round"/>
        `;
      }

      const animBodyCls = isStaticForCursor ? '' : 'svg-char-body';
      const animEyesCls = isStaticForCursor ? '' : 'svg-char-eyes';
      const animArmLCls = isStaticForCursor ? '' : 'svg-char-arm-l';
      const animFootLCls = isStaticForCursor ? '' : 'svg-char-foot-l';
      const animFootRCls = isStaticForCursor ? '' : 'svg-char-foot-r';

      return `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 116" class="w-full h-full overflow-visible">
          <!-- Soft Aura Background -->
          <circle cx="60" cy="60" r="48" fill="${spec.bg}" />
          <g class="${animBodyCls}">
            <!-- Cute Active Feet -->
            <ellipse cx="47" cy="99" rx="8" ry="5.5" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="2.8" class="${animFootLCls}"/>
            <ellipse cx="73" cy="99" rx="8" ry="5.5" fill="${spec.earColor}" stroke="${spec.stroke}" stroke-width="2.8" class="${animFootRCls}"/>
            <!-- Chibi Outfit & Torso -->
            ${spec.outfitSVG}
            <!-- Waving Left Arm -->
            <ellipse cx="30" cy="78" rx="8" ry="5.5" transform="rotate(-25 30 78)" fill="${spec.faceColor}" stroke="${spec.stroke}" stroke-width="2.8" class="${animArmLCls}"/>
            <!-- Right Arm -->
            <ellipse cx="89" cy="76" rx="8" ry="5.5" transform="rotate(20 89 76)" fill="${spec.faceColor}" stroke="${spec.stroke}" stroke-width="2.8"/>
            <!-- Ears -->
            ${earsMarkup}
            <!-- Cute Chibi Head -->
            <rect x="25" y="25" width="70" height="52" rx="26" fill="${spec.faceColor}" stroke="${spec.stroke}" stroke-width="3.4"/>
            <!-- Rosy Cheeks -->
            <ellipse cx="37" cy="58" rx="6" ry="3.8" fill="${spec.cheekColor}" opacity="0.65"/>
            <ellipse cx="83" cy="58" rx="6" ry="3.8" fill="${spec.cheekColor}" opacity="0.65"/>
            <!-- Eyes -->
            <g class="${animEyesCls}">
              ${eyesMarkup}
            </g>
            <!-- Mouth -->
            ${mouthMarkup}
            <!-- Hat / Headgear -->
            ${spec.hatSVG}
            <!-- Active Held Prop -->
            ${spec.propSVG}
          </g>
          ${isStaticForCursor ? '' : spec.fxSVG}
        </svg>
      `;
    }

    // 1에서 만들어진 맞춤형 캐릭터로 마우스 클리커(포인터 & 팔로워) 활성화
    function enableCharacterCursor(code) {
      const info = btiData[code] || btiData['PLSN'];
      isCharacterCursorActive = true;

      // 1) 네이티브 커서도 해당 유형의 캐릭터 SVG로 적용
      const rawCharSvg = createCuteCharacterSVG(code, true)
        .replace('class="w-full h-full overflow-visible"', 'width="48" height="48"')
        .trim();
      const encoded = encodeURIComponent(rawCharSvg);
      document.body.style.cursor = `url("data:image/svg+xml;utf8,${encoded}") 24 24, pointer`;

      // 2) 마우스를 따라다니는 활동적인 캐릭터 클리커 팔로워에도 동일한 16유형 캐릭터 적용
      const follower = document.getElementById('char-cursor-follower');
      const cursorCharSvgEl = document.getElementById('cursor-char-svg');
      if (cursorCharSvgEl) {
        cursorCharSvgEl.innerHTML = createCuteCharacterSVG(code, false);
      }
      document.getElementById('cursor-char-label').innerText = info.title;
      follower.classList.remove('hidden');
    }

    function disableCharacterCursor() {
      isCharacterCursorActive = false;
      document.body.style.cursor = 'default';
      const follower = document.getElementById('char-cursor-follower');
      if (follower) follower.classList.add('hidden');
    }

    window.addEventListener('mousemove', (e) => {
      if (!isCharacterCursorActive) return;
      const follower = document.getElementById('char-cursor-follower');
      if (follower) {
        follower.style.left = `${e.clientX + 26}px`;
        follower.style.top = `${e.clientY + 26}px`;
      }
    });

    window.addEventListener('mousedown', (e) => {
      if (!isCharacterCursorActive) return;
      const follower = document.getElementById('char-cursor-follower');
      if (follower) follower.classList.add('clicking');

      const sp = document.createElement('div');
      sp.className = 'click-sparkle';
      const sparkles = ['✨', '📖', '🌟', '🐾', '🔖'];
      sp.innerText = sparkles[Math.floor(Math.random() * sparkles.length)];
      sp.style.left = `${e.clientX}px`;
      sp.style.top = `${e.clientY}px`;
      document.body.appendChild(sp);
      setTimeout(() => sp.remove(), 650);
    });

    window.addEventListener('mouseup', () => {
      const follower = document.getElementById('char-cursor-follower');
      if (follower) follower.classList.remove('clicking');
    });


    // =========================================================================
    // 5. 단계별 화면 전환 로직 (Screen 1 -> Screen 2 -> Screen 3 -> Screen 4)
    // =========================================================================
    function showScreen(screenId) {
      ['screen-intro', 'screen-quiz', 'screen-result', 'screen-kdc'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          if (id === screenId) {
            el.classList.remove('hidden');
            el.classList.remove('animate-pop');
            void el.offsetWidth;
            el.classList.add('animate-pop');
          } else {
            el.classList.add('hidden');
          }
        }
      });

      if (screenId === 'screen-kdc') {
        enableCharacterCursor(currentBTI);
      } else {
        disableCharacterCursor();
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function startQuiz() {
      currentQIndex = 0;
      userAnswers = new Array(20).fill(null);
      renderCurrentQuestion();
      showScreen('screen-quiz');
    }

    function restartQuiz() {
      showScreen('screen-intro');
    }

    function renderCurrentQuestion() {
      const item = quizQuestions[currentQIndex];
      document.getElementById('quiz-current-num').innerText = currentQIndex + 1;
      document.getElementById('quiz-axis-badge').innerText = item.badge;
      document.getElementById('quiz-progress-bar').style.width = `${((currentQIndex + 1) / 20) * 100}%`;

      document.getElementById('quiz-emoji').innerText = item.emoji;
      document.getElementById('quiz-question-text').innerText = `Q${currentQIndex + 1}. ${item.q}`;

      document.getElementById('choice-a-emoji').innerText = item.a.emoji;
      document.getElementById('choice-a-text').innerText = item.a.text;

      document.getElementById('choice-b-emoji').innerText = item.b.emoji;
      document.getElementById('choice-b-text').innerText = item.b.text;

      const prevBtn = document.getElementById('btn-prev-q');
      if (currentQIndex === 0) {
        prevBtn.classList.add('invisible');
      } else {
        prevBtn.classList.remove('invisible');
      }
    }

    function selectAnswer(choice) {
      const item = quizQuestions[currentQIndex];
      userAnswers[currentQIndex] = choice === 'A' ? item.a.val : item.b.val;

      if (currentQIndex < 19) {
        currentQIndex++;
        renderCurrentQuestion();
      } else {
        finishQuizAndShowResult();
      }
    }

    function prevQuestion() {
      if (currentQIndex > 0) {
        currentQIndex--;
        renderCurrentQuestion();
      }
    }

    function finishQuizAndShowResult() {
      const counts = { P: 0, I: 0, L: 0, W: 0, S: 0, M: 0, N: 0, K: 0 };
      userAnswers.forEach(ans => {
        if (ans && counts[ans] !== undefined) counts[ans]++;
      });

      const a1 = counts.P >= counts.I ? 'P' : 'I';
      const a2 = counts.L >= counts.W ? 'L' : 'W';
      const a3 = counts.S >= counts.M ? 'S' : 'M';
      const a4 = counts.N >= counts.K ? 'N' : 'K';

      currentBTI = `${a1}${a2}${a3}${a4}`;
      renderResultScreen(counts);
      showScreen('screen-result');

      if (typeof confetti === 'function') {
        confetti({
          particleCount: 65,
          spread: 75,
          origin: { y: 0.6 },
          colors: ['#1B263B', '#C89B6E', '#415A77', '#E59866']
        });
      }
    }

    function renderResultScreen(counts) {
      const info = btiData[currentBTI] || btiData['PLSN'];

      document.getElementById('res-svg-avatar').innerHTML = createCuteCharacterSVG(currentBTI);
      document.getElementById('res-badge').innerText = currentBTI;
      document.getElementById('res-group-tag').innerText = info.group;
      document.getElementById('res-title').innerText = `${info.emoji} ${info.title}`;
      document.getElementById('res-desc').innerText = `"${info.desc}"`;
      document.getElementById('res-detail').innerText = info.detail;

      const pillsBox = document.getElementById('res-score-pills');
      const [c1, c2, c3, c4] = currentBTI.split('');
      const axisLabels = [
        { code: c1, name: c1 === 'P' ? '수다형 북토크(P)' : '고요한 묵독(I)', score: counts ? Math.max(counts.P, counts.I) : 5 },
        { code: c2, name: c2 === 'L' ? '논리·복선 추리(L)' : '감성 문장·서사(W)', score: counts ? Math.max(counts.L, counts.W) : 5 },
        { code: c3, name: c3 === 'S' ? '장면 시각화(S)' : '대사·리듬감(M)', score: counts ? Math.max(counts.S, counts.M) : 5 },
        { code: c4, name: c4 === 'N' ? '생태·자연 사색(N)' : '역동적 모험(K)', score: counts ? Math.max(counts.N, counts.K) : 5 }
      ];

      pillsBox.innerHTML = axisLabels.map(ax => `
        <div class="p-3 rounded-2xl border-2 bg-[#FAF8F5] border-[#D8CEBE] text-[#1B263B] text-center">
          <div class="text-xs font-bold text-[#B07D4F]">선택 지표 (${ax.score}/5)</div>
          <div class="font-hangang font-bold text-sm sm:text-base mt-0.5">${ax.name}</div>
        </div>
      `).join('');
    }

    function goToKdcStage() {
      const info = btiData[currentBTI] || btiData['PLSN'];
      document.getElementById('kdc-stage-emoji').innerHTML = createCuteCharacterSVG(currentBTI, false);
      document.getElementById('kdc-stage-code').innerText = currentBTI;
      document.getElementById('kdc-stage-charname').innerText = info.title;

      renderBooks();
      showScreen('screen-kdc');
    }

    function backToResult() {
      showScreen('screen-result');
    }


    // =========================================================================
    // 6. KDC 10대 주제 선택 & 경운중학교 DLS 도서 + 주제별 독서 활동 학습지 매칭 렌더링
    // =========================================================================
    function initKdcButtons() {
      const grid = document.getElementById('kdc-button-grid');
      grid.innerHTML = '';

      kdcCategories.forEach(cat => {
        const btn = document.createElement('button');
        btn.id = `btn-kdc-${cat.code}`;
        btn.onclick = () => selectKdc(cat.code);
        const isActive = cat.code === currentKDC;
        btn.className = `kdc-btn p-3.5 rounded-2xl text-left flex flex-col justify-between bg-[#FAF8F5] ${isActive ? 'kdc-badge-active' : 'text-[#1B263B]'}`;
        
        btn.innerHTML = `
          <div class="flex items-center justify-between w-full mb-1.5">
            <span class="kdc-sub px-2.5 py-0.5 bg-[#EAEFF5] text-[#1B263B] rounded-full text-xs font-bold">${cat.code}</span>
            <span class="text-2xl">${cat.emoji}</span>
          </div>
          <div>
            <div class="font-hangang text-base sm:text-lg font-bold leading-tight">${cat.name}</div>
            <div class="kdc-sub text-xs text-[#526071] font-namsan mt-0.5 bg-transparent">${cat.desc}</div>
          </div>
        `;
        grid.appendChild(btn);
      });
    }

    function selectKdc(code) {
      currentKDC = code;
      kdcCategories.forEach(c => {
        const b = document.getElementById(`btn-kdc-${c.code}`);
        if (b) {
          if (c.code === code) {
            b.className = "kdc-btn p-3.5 rounded-2xl text-left flex flex-col justify-between bg-[#FAF8F5] kdc-badge-active";
          } else {
            b.className = "kdc-btn p-3.5 rounded-2xl text-left flex flex-col justify-between bg-[#FAF8F5] text-[#1B263B]";
          }
        }
      });

      renderBooks();
    }

    function renderBooks() {
      const container = document.getElementById('book-cards-grid');
      const catObj = kdcCategories.find(c => c.code === currentKDC);
      const books = kdcBooks[currentKDC] || [];
      const charInfo = btiData[currentBTI] || { emoji: '✨', title: '독서가' };

      document.getElementById('active-kdc-tag').innerText = `${catObj.emoji} ${catObj.code} ${catObj.name}`;
      document.getElementById('recommend-section-title').innerText = `${charInfo.emoji} '${charInfo.title}' 맞춤 [${catObj.code} ${catObj.name}] 추천도서 3선`;

      container.innerHTML = '';

      books.forEach((book, idx) => {
        const dlsSearchUrl = `https://read365.edunet.net/SchoolSearchResult?searchKeyword=${encodeURIComponent(book.title)}&provCode=D10&neisCode=D100000830&schoolName=${encodeURIComponent('경운중학교')}`;
        const kyoboUrl = `https://search.kyobobook.co.kr/search?keyword=${encodeURIComponent(book.title)}`;

        const card = document.createElement('div');
        card.className = "bg-white rounded-3xl p-5 sm:p-6 border-2 border-[#E2D9C8] flex flex-col justify-between shadow-[0_6px_0_#E2D9C8] hover:-translate-y-1.5 hover:border-[#1B263B] transition duration-200";
        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between gap-1 mb-3">
              <span class="px-3 py-1 bg-[#F4EFE6] text-[#1B263B] border border-[#D8CEBE] text-xs font-bold rounded-full">
                ✨ 추천 PICK ${idx + 1}
              </span>
              <span class="px-2.5 py-1 bg-[#EAEFF5] text-[#1B263B] border border-[#C5D1E0] text-xs font-bold rounded-xl">
                📍 청구기호: ${book.callNo}
              </span>
            </div>

            <h4 class="font-hangang text-xl font-bold text-[#1B263B] leading-snug">
              《${book.title}》
            </h4>
            <div class="font-namsan text-sm font-bold text-[#526071] mt-1">
              ✍️ ${book.author} · ${book.publisher}
            </div>

            <div class="inline-block px-3 py-1 bg-[#FAF8F5] text-[#B07D4F] border border-[#E2D9C8] rounded-xl text-xs sm:text-sm font-bold mt-2.5">
              ${book.tag}
            </div>

            <p class="font-hangang text-sm sm:text-base text-[#1B263B] mt-3 leading-relaxed bg-[#FAF8F5] p-3.5 rounded-2xl border border-[#E2D9C8]">
              "${book.desc}"
            </p>
          </div>
          
          <div class="mt-4 pt-3.5 border-t-2 border-dashed border-[#E2D9C8] flex flex-col gap-2">
            <!-- 1. 경운중 DLS 확인 버튼 -->
            <a href="${dlsSearchUrl}" target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center space-x-1.5 px-3.5 py-2.5 bg-[#1B263B] hover:bg-[#273752] text-[#FAF8F5] text-xs sm:text-sm font-bold rounded-full shadow-sm transition">
              <i class="fa-solid fa-school text-xs text-[#F5CBA7]"></i>
              <span>경운중 DLS 도서관 위치·대출 확인</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>

            <!-- 2. 교보문고 책 소개 보기 버튼 -->
            <a href="${kyoboUrl}" target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center space-x-1.5 px-3.5 py-2 bg-[#FAF8F5] hover:bg-[#415A77] text-[#1B263B] hover:text-white border border-[#D8CEBE] text-xs sm:text-sm font-bold rounded-full transition">
              <i class="fa-solid fa-book-open text-xs"></i>
              <span>교보문고 책 소개 보기</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>
          </div>
        `;
        container.appendChild(card);
      });
    }


    // =========================================================================
    // 7. 16유형 한눈에 보기 렌더링 (베이지 & 네이비 테마)
    // =========================================================================
    function render16TypesShowcase() {
      const container = document.getElementById('types-16-showcase');
      const groups = [
        {
          title: '💬 소통 & 논리탐구 그룹 (P-L)',
          sub: '친구들과 수다 떨며 책 속 복선과 논리적 원리를 파헤치는 그룹',
          headerCls: 'bg-[#1B263B] text-[#FAF8F5]',
          codes: ['PLSN', 'PLSK', 'PLMN', 'PLMK']
        },
        {
          title: '💌 소통 & 감성서사 그룹 (P-W)',
          sub: '따뜻한 문장과 인물의 감정을 친구들과 다정하게 나누는 그룹',
          headerCls: 'bg-[#8C5E3C] text-[#FAF8F5]',
          codes: ['PWSN', 'PWSK', 'PWMN', 'PWMK']
        },
        {
          title: '🔭 성찰 & 원리탐구 그룹 (I-L)',
          sub: '조용한 나만의 공간에서 세상의 법칙과 지식을 깊이 탐구하는 그룹',
          headerCls: 'bg-[#2B4C5E] text-[#FAF8F5]',
          codes: ['ILSN', 'ILSK', 'ILMN', 'ILMK']
        },
        {
          title: '🎨 성찰 & 문학예술 그룹 (I-W)',
          sub: '혼자만의 고요한 시간 속에서 아름다운 문장과 상상력에 푹 빠지는 그룹',
          headerCls: 'bg-[#415A77] text-[#FAF8F5]',
          codes: ['IWSN', 'IWSK', 'IWMN', 'IWMK']
        }
      ];

      container.innerHTML = groups.map(g => `
        <div class="rounded-3xl border-2 border-[#E2D9C8] p-5 bg-[#FAF8F5]">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <span class="px-4 py-1.5 ${g.headerCls} font-hangang font-bold text-base sm:text-lg rounded-full self-start shadow-xs">
              ${g.title}
            </span>
            <span class="text-xs sm:text-sm font-bold text-[#526071]">${g.sub}</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            ${g.codes.map(code => {
              const d = btiData[code];
              return `
                <div onclick="selectTypeFromShowcase('${code}')" class="bg-white rounded-2xl p-4 border-2 border-[#E2D9C8] hover:border-[#1B263B] hover:-translate-y-1.5 transition cursor-pointer shadow-[0_4px_0_#E2D9C8] flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <span class="px-3 py-0.5 ${d.badgeCls} font-bold text-xs rounded-full tracking-wider">${code}</span>
                      <div class="w-16 h-16">${createCuteCharacterSVG(code, false)}</div>
                    </div>
                    <h3 class="font-hangang text-lg font-bold text-[#1B263B] mt-1">${d.title}</h3>
                    <p class="font-namsan text-sm text-[#415A77] mt-1.5 leading-relaxed">${d.desc}</p>
                  </div>
                  <div class="mt-3 pt-2 border-t border-[#E2D9C8] text-right">
                    <span class="text-xs font-bold text-[#B07D4F]">이 캐릭터로 책 찾기 →</span>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `).join('');
    }

    function selectTypeFromShowcase(code) {
      currentBTI = code;
      switchView('interactive');
      renderResultScreen(null);
      showScreen('screen-result');
    }

    // 8. 상단 탭 뷰 전환
    function switchView(mode) {
      const vInt = document.getElementById('view-interactive');
      const vLeaf = document.getElementById('view-leaflet');
      const tInt = document.getElementById('tab-interactive');
      const tLeaf = document.getElementById('tab-leaflet');

      if (mode === 'interactive') {
        vInt.classList.remove('hidden');
        vLeaf.classList.add('hidden');
        tInt.className = "px-4 py-1.5 bg-[#1B263B] text-[#FAF8F5] text-sm font-bold rounded-full transition duration-200 flex items-center space-x-1.5 shadow-sm";
        tLeaf.className = "px-4 py-1.5 text-[#1B263B] hover:bg-[#E8E0D2] text-sm font-bold rounded-full transition duration-200 flex items-center space-x-1.5";
        if (!document.getElementById('screen-kdc').classList.contains('hidden')) {
          enableCharacterCursor(currentBTI);
        }
      } else {
        vInt.classList.add('hidden');
        vLeaf.classList.remove('hidden');
        tLeaf.className = "px-4 py-1.5 bg-[#1B263B] text-[#FAF8F5] text-sm font-bold rounded-full transition duration-200 flex items-center space-x-1.5 shadow-sm";
        tInt.className = "px-4 py-1.5 text-[#1B263B] hover:bg-[#E8E0D2] text-sm font-bold rounded-full transition duration-200 flex items-center space-x-1.5";
        disableCharacterCursor();
      }
    }

    // 초기화
    window.onload = function() {
      const introMascotEl = document.getElementById('intro-mascot-showcase');
      if (introMascotEl) {
        introMascotEl.innerHTML = ['PLSN', 'PWSN', 'ILSN', 'IWSN']
          .map(c => `<div class="w-16 h-16 sm:w-20 sm:h-20">${createCuteCharacterSVG(c, false)}</div>`)
          .join('');
      }
      initKdcButtons();
      render16TypesShowcase();
      renderBooks();
    };
  </script>
</body>
</html>
